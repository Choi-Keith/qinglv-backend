syntax = "v1"

import (
	"user.api"
	"following.api"
	"blacklist.api"
)

// no need login
@server (
	prefix: /user/v1
	group:  user
)
service user {
	@doc "注册"
	@handler register
	post /register (RegisterReq) returns (User)

	@doc "邮件验证"
	@handler verifyEmail
	get /email/verify (VerifyEmailReq) returns (VerifyEmailResp)

	@doc "获取登录验证码"
	@handler loginCaptcha
	get /login/captcha returns (LoginCaptchaResp)

	@doc "登录"
	@handler login
	post /login (LoginReq) returns (LoginResp)

	@doc "用户列表"
	@handler getUserList
	get /user (UserListReq) returns (UserListResp)

	@doc "用户详情"
	@handler getUserById
	get /user/:id (getUserByIdReq) returns (User)
}

// need login
@server (
	prefix:     /user/v1
	group:      user
	jwt:        JWTAuth
	middleware: Authority
)
service user {
	@doc "退出"
	@handler logout
	post /logout

	@doc "获取当前用户"
	@handler getCurrentUser
	get /user/current returns (User)

	@doc "修改密码"
	@handler updatePassword
	put /password (PasswordReq)

	@doc "禁止用户"
	@handler banUser
	put /user/ban/:id (BanUserReq)

	@doc "修改用户头像"
	@handler updateAvatar
	put /user/:id/avatar (AvatarReq)

	@doc "修改个人主页背景"
	@handler updateProfileBg
	put /user/:id/background/image (UpdateProfileReq)

	@doc "更改个人信息"
	@handler updateUser
	put /user/:id (UpdateUserReq)

	@doc "删除用户"
	@handler delUser
	delete /user/:id (DelUserReq)
}

@server (
	prefix:     /user/v1
	group:      role
	jwt:        JWTAuth
	middleware: Authority
)
service user {
	@doc "获取角色列表"
	@handler getRoleList
	get /role (RoleListReq) returns (RoleListResp)

	@doc "获取角色详情"
	@handler getRoleByID
	get /role/:id returns (Role)

	@doc "创建角色"
	@handler addRole
	post /role (RoleReq)

	@doc "更改角色"
	@handler updateRole
	put /role/:id (Role)

	@doc "删除角色"
	@handler delRole
	delete /role/:id
}

@server (
	prefix:     /user/v1
	group:      following
	jwt:        JWTAuth
	middleware: Authority
)
service user {
	@doc "关注列表"
	@handler getFollowingList
	get /following (FollowingListReq) returns (FollowingListResp)

	@doc "粉丝列表"
	@handler getFollowerList
	get /follower (FollowerListReq) returns (FollowerListResp)

	@doc "关注"
	@handler addFollowing
	post /following (AddFollowingReq)

	@doc "取消关注"
	@handler delFollowing
	delete /following (DelFollowingReq)

	@doc "查看是否关注"
	@handler isFollowing
	get /following/is (IsFollowingReq) returns (IsFollowingResp)
}

@server (
	prefix:     /user/v1
	group:      blacklist
	jwt:        JWTAuth
	middleware: Authority
)
service user {
	@doc "黑名单"
	@handler getBlacklist
	get /blacklist (BlacklistReq) returns (BlacklistResp)

	@doc "添加黑名单"
	@handler addBlacklist
	post /blacklist (AddBlackItemReq)

	@doc "取消黑名单"
	@handler delBlacklist
	delete /blacklist (DelBlackItemReq)

	@doc "是否黑名单"
	@handler isBlackItem
	get /blacklist/is (IsBlackItemReq) returns (IsBlackItemResp)
}

