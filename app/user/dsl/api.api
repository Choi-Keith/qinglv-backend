syntax = "v1"

import (
	"user.api"
	"following.api"
	"follower.api"
	"blacklist.api"
)

// no need login
@server (
	prefix: /user/v1
	group:  user
)
service user {
	@doc "register"
	@handler register
	post /register (RegisterReq) returns (User)

	@doc "verify email"
	@handler verifyEmail
	get /email/verify (VerifyEmailReq) returns (VerifyEmailResp)

	@doc "login captcha"
	@handler loginCaptcha
	get /login/captcha returns (LoginCaptchaResp)

	@doc "login"
	@handler login
	post /login (LoginReq) returns (LoginResp)

	@doc "user list"
	@handler getUserList
	get /user (UserListReq) returns (UserListResp)

	@doc "user detail by id"
	@handler getUserById
	get /user/:id (getUserByIdReq) returns (User)
}

// need login
@server (
	prefix: /user/v1
	group:  user
	jwt:    JWTAuth
)
service user {
	@doc "current user"
	@handler getCurrentUser
	get /user/current returns (User)

	@doc "update password"
	@handler updatePassword
	put /password (PasswordReq)

	@doc "ban user"
	@handler banUser
	put /user/ban/:id (BanUserReq)

	@doc "update avatar"
	@handler updateAvatar
	put /user/:id/avatar (AvatarReq)

	@doc "update profileBg"
	@handler updateProfileBg
	put /user/:id/background/image (UpdateProfileReq)

	@doc "update user info"
	@handler updateUser
	put /user/:id (UpdateUserReq)

	@doc "delete user"
	@handler delUser
	delete /user/:id (DelUserReq)
}

@server (
	prefix: /user/v1
	group:  role
	jwt:    JWTAuth
)
service user {
	@doc "role list"
	@handler getRoleList
	get /role (RoleListReq) returns (RoleListResp)

	@doc "role detail"
	@handler getRoleByID
	get /role/:id returns (Role)

	@doc "create role"
	@handler addRole
	post /role (RoleReq)

	@doc "update role"
	@handler updateRole
	put /role/:id (Role)

	@doc "delete role"
	@handler delRole
	delete /role/:id
}

@server (
	prefix: /user/v1
	group:  following
	jwt:    JWTAuth
)
service user {
	@doc "following list"
	@handler getFollowingList
	get /following (FollowingListReq) returns (FollowingListResp)

	@doc "add following"
	@handler addFollowing
	post /following (AddFollowingReq)

	@doc "cancel following"
	@handler delFollowing
	delete /following (DelFollowingReq)

	@doc "is following"
	@handler isFollowing
	get /following/is (IsFollowingReq) returns (IsFollowingResp)
}

@server (
	prefix: /user/v1
	group:  follower
	jwt:    JWTAuth
)
service user {
	@doc "follower list"
	@handler getFollowerList
	get /follower (FollowerListReq) returns (FollowerListResp)

	@doc "add follower"
	@handler addFollower
	post /follower (AddFollowerReq)

	@doc "cancel follower"
	@handler delFollower
	delete /follower (DelFollowerReq)

	@doc "is follower"
	@handler isFollower
	get /follower/is (IsFollowerReq) returns (IsFollowerResp)
}

@server (
	prefix: /user/v1
	group:  blacklist
	jwt:    JWTAuth
)
service user {
	@doc "blacklist list"
	@handler getBlacklist
	get /blacklist (BlacklistReq) returns (BlacklistResp)

	@doc "add blacklist"
	@handler addBlacklist
	post /blacklist (AddBlackItemReq)

	@doc "cancel blacklist"
	@handler delBlacklist
	delete /blacklist (DelBlackItemReq)

	@doc "is black"
	@handler isBlackItem
	get /blacklist/is (IsBlackItemReq) returns (IsBlackItemResp)
}

