syntax = "v1"

info (
	title:   "用户服务"
	desc:    "用户服务"
	author:  "choi"
	email:   "1278028801@qq.com"
	version: "v1"
)

type Role {
	ID        uint64 `json:"id,string"`
	UserId    uint64 `json:"userId,string"`
	Name      string `json:"name"`
	CreatedAt uint64 `json:"createdAt"`
	UpdatedAt uint64 `json:"updatedAt"`
}

type RoleReq {
	Name string `json:"name" validate:"required,max=50"`
}

type Resp {
	Role Role `json:"role"`
}

type (
	RoleListReq {
		UserId   uint64 `json:"userId,string,optional"`
		Name     string `json:"name,optional"`
		PageNum  int    `json:"pageNum"`
		PageSize int    `json:"pageSize"`
	}
	RoleListResp {
		List  []Role `json:"list"`
		IsEnd bool   `json:"isEnd"`
		Total bool   `json:"total"`
	}
)

type EmailReq {
	Email string `json:"email" validate:"email,max=50"`
}

type PhoneReq {
	Phone string `json:"phone" validate:"len=11"`
}

type (
	RegisterReq {
		RoleId     uint64 `json:"roleId,string"`
		Nickname   string `json:"nickname" validate:"required,max=50"`
		Email      string `json:"email" validate:"required,email,max=50"`
		Password   string `json:"password" validate:"required,min=6,max=50"`
		RePassword string `json:"rePassword" validate:"required,min=6,max=50,eqfield=Password"`
	}
	RegisterResp {
		User User `json:"user"`
	}
)

type User {
	Id        uint64 `json:"id"`
	Role      Role   `json:"role"`
	RoleId    uint64 `json:"roleId"`
	Nickname  string `json:"nickname"`
	Email     string `json:"email"`
	WeChat    string `json:"weChat"`
	Motto     string `json:"motto"`
	Avatar    string `json:"avatar"`
	ProfileBg string `json:"profileBg"`
	Age       int    `json:"age,range=[0:120]"`
	Gender    int    `json:"gender,options=[0,1],default=0"`
	Location  string `json:"location"`
	Status    int    `json:"status"`
	Level     int    `json:"level"`
	Score     int    `json:"score"`
	CreatedAt uint64 `json:"createdAt"`
	UpdatedAt uint64 `json:"updatedAt"`
}

type (
	LoginReq {
		Email      string `json:"email" validate:"required,email,max=50"`
		Password   string `json:"password" validate:"required,min=6,max=50"`
		CaptchId   string `json:"captchId,string"`
		CaptchCode string `json:"captchCode"`
		VerifyCode string `json:"VerifyCode"`
	}
	LoginResp {
		AccessToken  string `json:"accessToken"`
		RefreshToken string `json:"refressToken"`
		ExpireAt     uint64 `json:"refreshAt"`
	}
)

type (
	PasswordReq {
		OldPassword string `json:"oldPassword" validate:"required,min=6,max=24"`
		NewPassword string `json:"newPassword" validate:"required,min=6,max=24"`
		RePassword  string `json:"rePassword" validate:"required,min=6,max=24,eqfield=NewPassword"`
	}
)



type (
	UserListReq {
		Nickname string `json:"nickname,optional"`
		Email    string `json:"email,optional"`
		Phone    string `json:"phone,optional"`
		WeChat   string `json:"weChat,optional"`
		PageNum  int    `json:"pageNum" validate:"required,gt=0"`
		PageSize int    `json:"pageSize" validate:"required,gt=0"`
	}
	UserListResp {
		List  []User `json:"list"`
		IsEnd bool   `json:"isEnd"`
		Total bool   `json:"total"`
	}
)

type (
	UserReq {
		Nickname string `json:"nickname" validate:"max=50"`
		RoldId   uint64 `json:"roleId,string"`
		Motto    string `json:"motto" validate:"max=200"`
		Age      int    `json:"age,range=[0:120]" validate:"number,gt=0,lt=130"`
		Gender   int    `json:"gender,options=[0,1],default=0" validate:"oneof=0,1"`
		Location string `json:"location" validate:"max=200"`
		Status   int    `json:"status,options=[0,1,2]" validate:"oneof=0,1,2"`
		Level    int    `json:"level" validate:"number,gte=0,lte=10"`
		Score    int    `json:"score" validate:"number,gte=0`
	}
	UserResp {
		User User `json:"user"`
	}
)

