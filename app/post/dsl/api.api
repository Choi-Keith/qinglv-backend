syntax = "v1"

@server(
    prefix: post/v1
    group: post
)
service post {
    @doc "get post list"
    @handler getPostList
    get /post (PostListReq) returns (PostListResp)

    @doc "get post list by id"
    @handler createPost
    get /post/:id  returns (Post)

    @doc "create post"
    @handler createPost
    post /post (Post) returns (PostResp)

    @doc "update post"
    @handler updatePost
    put /post/:id (DelPostReq) returns (PostResp)

    @doc "delete post"
    @handler delPost
    delete /post/:id
}