syntax = "v1"

info (
    title: "收藏服务"
    desc: "包括收藏分组，以及帖子，文章和视频等的收藏内容"
    author: "ksoncai"
    email: "aksoncai@gmail.com"
    version: "v1"
)
type CollectionGroupItem {
    Id uint64 `json:"id,string"`
    CreatorId uint64 `json:"creatorId,string"`
    Name string `json:"name"`
    Visibility int32 `json:"visibility"`
    BizType int32 `json:"bizType"`
    CreatedAt uint64 `json:"createdAt"`
    UpdatedAt uint64 `json:"updatedAt"`
}
type (
    GetCollectionGroupListReq {
        Name string `form:"name,optional"`
        Visibility int32 `form:"visibility,optional"`
        BizType int32 `form:"bizType,optional"`
        CreatorId uint64 `form:"creatorId,string,optional"`
		PageNum    int32  `form:"pageNum" validate:"required,gt=0"`
		PageSize   int32  `form:"pageSize" validate:"required,gt=0"`
    }
    GetCollectionGropListResp{
        List []CollectionGroupItem `json:"list"`
        IsEnd bool `json:"isEnd"`
        Total uint64 `json:"total"`
    }
)

type AddCollectionGroup {
    Name string `json:"name"`
    Visibility int32 `json:"visibility,options=[1,2],default=1"`
    BizType int32 `json:"bizType,options=[1,2,3]"`
}

type DeleteCollectionGroup {
    Id uint64 `path:"id,string"`
}

type UpdateCollectionGroup {
    Id uint64 `json:"id,string"`
    Name string `json:"name"`
    Visibility int32 `json:"visibility,options=[1,2],default=1"`
    BizType int32 `json:"bizType,options=[1,2,3]"`
}