syntax = "v1"

import (
	"collection.api"
	"thumb.api"
	"share.api"
	"comment.api"
)

//no need login
@server (
	prefix: /operation/v1
	group:  collection_group
)
service operation {
	@doc "收藏列表分组"
	@handler getCollectionGroupList
	get /collection/group (GetCollectionGroupListReq) returns (GetCollectionGropListResp)
}

// need login
@server (
	prefix:     /operation/v1
	group:      collection_group
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "新建收藏分组"
	@handler addCollectionGroup
	post /collection/group (AddCollectionGroup)

	@doc "删除收藏分组"
	@handler deleteCollectionGroup
	delete /collection/group/:id (DeleteCollectionGroup)

	@doc "修改收藏分组"
	@handler updateCollectionGroup
	put /collection/group/:id (UpdateCollectionGroup)
}

//no need login
@server (
	prefix: /operation/v1
	group:  collection
)
service operation {
	@doc "收藏列表"
	@handler getCollectionList
	get /collection (GetCollectionListReq) returns (GetCollectionListResp)
}

// need login
@server (
	prefix:     /operation/v1
	group:      collection
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "新建收藏"
	@handler addCollection
	post /collection (AddCollectionReq)

	@doc "取消收藏"
	@handler deleteCollection
	delete /collection/:id (DeleteCollectionReq)
}

// need login
@server (
	prefix:     /operation/v1
	group:      share
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "帖子分享"
	@handler addPostShare
	post /post/share (AddPostShareReq)

	@doc "文章分享"
	@handler addArticleShare
	post /article/share (AddArticleShareReq)
}

// need login
@server (
	prefix:     /operation/v1
	group:      thumb
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "帖子点赞"
	@handler handlePostThumbUp
	post /post/thumb/up (HandlePostThumbUpReq)

	@doc "帖子点踩"
	@handler handlePostThumbDown
	post /post/thumb/down (HandlePostThumbDownReq)

	@doc "帖子评论点赞"
	@handler handlePostCommentThumbUp
	post /post/comment/thumb/up (HandlePostCommentThumbUpReq)

	@doc "帖子评论点踩"
	@handler handlePostCommentThumbDown
	post /post/comment/thumb/down (HandlePostCommentThumbDownReq)

	@doc "帖子回复评论点赞"
	@handler handlePostCommentReplyThumbUp
	post /post/comment/reply/thumb/up (HandlePostCommentReplyThumbUpReq)

	@doc "帖子回复评论点踩"
	@handler handlePostCommentReplyThumbDown
	post /post/comment/reply/thumb/down (HandlePostCommentReplyThumbDownReq)

	@doc "文章点赞"
	@handler handleArticleThumbUp
	post /article/thumb/up (HandleArticleThumbUpReq)

	@doc "文章点踩"
	@handler handleArticleThumbDown
	post /article/thumb/down (HandleArticleThumbDownReq)

	@doc "文章评论点赞"
	@handler handleArticleCommentThumbUp
	post /article/comment/thumb/up (HandleArticleCommentThumbUpReq)

	@doc "文章评论点踩"
	@handler handleArticleCommentThumbDown
	post /article/comment/thumb/down (HandleArticleCommentThumbDownReq)

	@doc "文章回复评论点赞"
	@handler handleArticleCommentReplyThumbUp
	post /article/comment/reply/thumb/up (HandleArticleCommentReplyThumbUpReq)

	@doc "文章回复评论点踩"
	@handler handleArticleCommentReplyThumbDown
	post /article/comment/reply/thumb/down (HandleArticleCommentReplyThumbDownReq)
}

// no need login
@server (
	prefix: /operation/v1
	group:  comment
)
service operation {
	@doc "获取帖子评论"
	@handler getPostCommentList
	get /post/comment (GetPostCommentListReq) returns (GetPostCommentListResp)

	@doc "获取帖子评论回复"
	@handler getPostCommentReplyList
	get /post/comment/reply (GetPostCommentReplyListReq) returns (GetPostCommentReplyListResp)

	@doc "获取文章评论"
	@handler getArticleCommentList
	get /article/comment (GetArticleCommentListReq) returns (GetArticleCommentListResp)

	@doc "获取文章评论回复"
	@handler getArticleCommentReplyList
	get /article/comment/reply (GetArticleCommentReplyListReq) returns (GetArticleCommentReplyListResp)
}

// need login
@server (
	prefix:     /operation/v1
	group:      comment
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "添加帖子评论"
	@handler addPostComment
	post /post/comment (AddPostCommentReq)

	@doc "删除帖子评论"
	@handler deletePostComment
	delete /post/comment/:id (DeletePostCommentReq)

	@doc "添加帖子评论回复"
	@handler addPostCommentReply
	post /post/comment/reply (AddPostCommentReplyReq)

	@doc "删除帖子评论回复"
	@handler deletePostCommentReply
	delete /post/comment/reply/:id (DeletePostCommentReplyReq)

	@doc "添加文章评论"
	@handler addArticleComment
	post /article/comment (AddArticleCommentReq)

	@doc "删除文章评论"
	@handler deleteArticleComment
	delete /article/comment/:id (DeleteArticleCommentReq)

	@doc "添加文章评论回复"
	@handler addArticleCommentReply
	post /article/comment/reply (AddArticleCommentReplyReq)

	@doc "删除文章评论回复"
	@handler deleteArticleCommentReply
	delete /article/comment/reply/:id (DeleteArticleCommentReplyReq)
}

