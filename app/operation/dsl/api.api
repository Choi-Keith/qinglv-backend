syntax = "v1"

import (
	"collection.api"
	"thumb.api"
	"share.api"
	"comment.api"
)

//no need login
@server (
	prefix: /operation/v1
	group:  collection_group
)
service operation {
	@doc "收藏列表分组"
	@handler getCollectionGroupList
	get /collection/group (GetCollectionGroupListReq) returns (GetCollectionGropListResp)
}

// need login
@server (
	prefix:     /operation/v1
	group:      collection_group
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "新建收藏分组"
	@handler addCollectionGroup
	post /collection/group (AddCollectionGroup)

	@doc "删除收藏分组"
	@handler deleteCollectionGroup
	delete /collection/group/:id (DeleteCollectionGroup)

	@doc "修改收藏分组"
	@handler updateCollectionGroup
	put /collection/group/:id (UpdateCollectionGroup)
}

//no need login
@server (
	prefix: /operation/v1
	group:  collection
)
service operation {
	@doc "收藏列表"
	@handler getCollectionList
	get /collection (GetCollectionListReq) returns (GetCollectionListResp)
}

// need login
@server (
	prefix:     /operation/v1
	group:      collection
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "新建收藏"
	@handler addCollection
	post /collection (AddCollectionReq)

	@doc "取消收藏"
	@handler deleteCollection
	delete /collection/:id (DeleteCollectionReq)
}

// need login
@server (
	prefix:     /operation/v1
	group:      share
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "分享"
	@handler addPostShare
	post /post/share (AddPostShareReq)
}

// need login
@server (
	prefix:     /operation/v1
	group:      thumb
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "帖子点赞"
	@handler handlePostThumbUp
	post /post/thumb/up (HandlePostThumbUpReq)

	@doc "帖子点踩"
	@handler handlePostThumbDown
	post /post/thumb/down (HandlePostThumbDownReq)

	@doc "帖子评论点赞"
	@handler handlePostCommentThumbUp
	post /post/comment/thumb/up (HandlePostCommentThumbUpReq)

	@doc "帖子评论点踩"
	@handler handlePostCommentThumbDown
	post /post/comment/thumb/down (HandlePostCommentThumbDownReq)

	@doc "帖子回复评论点赞"
	@handler handlePostCommentReplyThumbUp
	post /post/comment/reply/thumb/up (HandlePostCommentReplyThumbUpReq)

	@doc "帖子回复评论点踩"
	@handler handlePostCommentReplyThumbDown
	post /post/comment/reply/thumb/down (HandlePostCommentReplyThumbDownReq)
}

// no need login
@server (
	prefix: /operation/v1
	group:  comment
)
service operation {
	@doc "帖子评论"
	@handler getPostCommentList
	get /post/comment (GetPostCommentListReq) returns (GetPostCommentListResp)

	@doc "帖子评论回复"
	@handler getPostCommentReplyList
	get /post/comment/reply (GetPostCommentReplyListReq) returns (GetPostCommentReplyListResp)
}

// need login
@server (
	prefix:     /operation/v1
	group:      comment
	jwt:        JWTAuth
	middleware: Authority
)
service operation {
	@doc "添加评论"
	@handler addPostComment
	post /post/comment (AddPostCommentReq)

	@doc "删除评论"
	@handler deletePostComment
	delete /post/comment/:id (DeletePostCommentReq)

	@doc "添加评论回复"
	@handler addPostCommentReply
	post /post/comment/reply (AddPostCommentReplyReq)

	@doc "删除评论回复"
	@handler deletePostCommentReply
	delete /post/comment/reply/:id (DeletePostCommentReplyReq)
}

