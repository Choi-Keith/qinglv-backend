// ===========================Post==============================
// no need login
@server (
	prefix: /content/v1
	group:  post
)
service content {
	@doc "帖子列表"
	@handler getPostList
	get /post (GetPostListReq) returns (GetPostListResp)

	@doc "根据id获取帖子详情"
	@handler getPostById
	get /post/:id (GetPostByIdReq) returns (GetPostByIdResp)

	@doc "我的帖子列表"
	@handler getUserPostList
	get /user/post (GetUserPostListReq) returns (GetUserPostListResp)
}

// need login
@server (
	prefix:     /content/v1
	group:      post
	jwt:        JWTAuth
	middleware: Authority
)
service content {
	@doc (
		summary: "新建帖子"
	)
	@handler addPost
	post /post (AddPostReq)

	@doc (
		summary: "删除"
	)
	@handler deletePost
	delete /post/:id (DeletePostReq)
}

// need login
@server (
	prefix:     /content/v1
	group:      upload
	jwt:        JWTAuth
	middleware: Authority
)
service content {
	@doc (
		summary: "上传图片"
	)
	@handler uploadImages
	post /image/upload/:type (UploadImagesReq) returns (UploadImagesResp)

	@doc (
		summary: "删除图片"
	)
	@handler removeImages
	delete /image/remove (RemoveImagesReq)
}

