syntax = "v1"

import (
	"topic.api"
	"category.api"
	"upload.api"
	"post.api"
	"tag.api"
	"article.api"
)

// ===========================Topic==============================
//no need login
@server (
	prefix: /content/v1
	group:  topic
)
service content {
	@doc "帖子话题列表"
	@handler getTopicList
	get /topic (GetTopicListReq) returns (GetTopicListResp)

	@doc "通过Id获取话题详情"
	@handler getTopicById
	get /topic/:id (GetTopicByIdReq) returns (GetTopicByIdResp)

	@doc "通过name获取话题详情"
	@handler getTopicByName
	get /topic/name (GetTopicByNameReq) returns (GetTopicByNameResp)
}

// need login
@server (
	prefix:     /content/v1
	group:      topic
	jwt:        JWTAuth
	middleware: Authority
)
service content {
	@doc "新建帖子话题"
	@handler addTopic
	post /topic (AddTopicReq)

	@doc "删除帖子话题"
	@handler deleteTopic
	delete /topic/:id (DeleteTopicReq)

	@doc "修改帖子话题"
	@handler updateTopic
	put /topic/:id (UpdateTopicReq)
}

