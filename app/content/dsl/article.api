syntax = "v1"

info (
	title:   "文章"
	desc:    "文章"
	author:  "choikeith"
	email:   "aksoncai@gmail.com"
	version: "v1"
)

type ArticleUser {
	Id          uint64 `json:"id"`
	IsFollowing bool   `json:"isFollowing"`
	Nickname    string `json:"nickname"`
	Motto       string `json:"motto"`
	Avatar      string `json:"avatar"`
	Profession  string `json:"profession"`
	Age         int    `json:"age,range=[0:120]"`
	Gender      int    `json:"gender,options=[1,2],default=1"`
	Level       int    `json:"level"`
	Score       int    `json:"score"`
}

type ArticleCategory {
	Id          uint64 `json:"id,string"`
	Name        string `json:"name"`
	Image       string `json:"image"`
	Description string `json:"description"`
	QuoteCount  string `json:"quoteCount"`
}

type ArticleItem {
	Id              uint64          `json:"id,string"`
	Category        ArticleCategory `json:"category"`
	Tag             []string        `json:"tag"`
	Title           string          `json:"title"`
	Introduction    string          `json:"introduction"`
	Content         string          `json:"content"`
	CoverImage      string          `json:"coverImage"`
	Creator         ArticleUser     `json:"creator"`
	Status          int             `json:"status"`
	Visibility      int             `json:"visibility"`
	IsTop           int             `json:"isTop"`
	Score           uint64          `json:"score"`
	CommentCount    uint64          `json:"commentCount"`
	CollectionCount uint64          `json:"collectionCount"`
	LikeCount       uint64          `json:"likeCount"`
	DislikeCount    uint64          `json:"dislikeCount"`
	ShareCount      uint64          `json:"shareCount"`
	CreatedAt       uint64          `json:"createdAt"`
	UpdatedAt       uint64          `json:"updatedAt"`
}

type AddArticleReq {
	CategoryId uint64   `json:"categoryId,string,optional"`
	Tag        []string `json:"tag,optional"`
	Title      string   `json:"title" validate:"max=40"`
	Desc       string   `json:"desc,optional" validate:"max=200"`
	Content    string   `json:"content"`
	CoverImage string   `json:"coverImage,optional"`
	Visibility int      `json:"visibility,optional"`
}

type UpdateArticleReq {
	Id         uint64   `json:"id,string"`
	CategoryId uint64   `json:"categoryId,string,optional"`
	Tag        []string `json:"tag,optional"`
	Title      string   `json:"title,optional" validate:"max=40"`
	Desc       string   `json:"desc,optional" validate:"max=200"`
	Content    string   `json:"content,optional"`
	CoverImage string   `json:"coverImage,optional"`
	Visibility int      `json:"visibility,optional"`
}

type DeleteArticleReq {
	Id uint64 `path:"id,string"`
}

type (
	GetUserArticleListReq {
		CreatorId uint64 `form:"creatorId,string,optional"`
		Title     string `form:"keyword,optional"`
		Sort      string `form:"sort,optional"`
		PageNum   int32  `form:"pageNum" validate:"required,gt=0"`
		PageSize  int32  `form:"pageSize" validate:"required,gt=0"`
	}
	GetUserArticleListResp {
		List  []ArticleItem `json:"list"`
		IsEnd bool          `json:"isEnd"`
		Total uint64        `json:"total"`
	}
)

type (
	GetArticleListReq {
		Creator    string `form:"creator,optional"`
		Status     int    `form:"status,optional"`
		Visibility int    `form:"visibility,optional"`
		Sort       string `form:"sort,optional"`
		Score      uint64 `form:"score,optional"`
		Title      string `form:"title,optional"`
		PageNum    int32  `form:"pageNum" validate:"required,gt=0"`
		PageSize   int32  `form:"pageSize" validate:"required,gt=0"`
	}
	GetArticleListResp {
		List  []ArticleItem `json:"list"`
		IsEnd bool          `json:"isEnd"`
		Total uint64        `json:"total"`
	}
)

type (
	GetArticleByIdReq {
		Id uint64 `path:"id,string"`
	}
	GetArticleByIdResp {
		Article ArticleItem `json:"article"`
	}
)

