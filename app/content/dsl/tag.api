syntax = "v1"

info (
	title:   "标签"
	desc:    "文章标签"
	author:  "choikeith"
	email:   "aksoncai@gmail.com"
	version: "v1"
)

type TagUser {
	Id         uint64 `json:"id,string"`
	Nickname   string `json:"nickname"`
	Motto      string `json:"motto"`
	Avatar     string `json:"avatar"`
	Profession string `json:"profession"`
	Age        int    `json:"age,range=[0:120]"`
	Gender     int    `json:"gender,options=[1,2],default=1"`
	Level      int    `json:"level"`
	Score      int    `json:"score"`
}

type TagItem {
	Id          uint64  `json:"id,string"`
	Name        string  `json:"name"`
	Image       string  `json:"image"`
	Description string  `json:"description"`
	QuoteCount  uint64  `json:"quoteCount"`
	Creator     TagUser `json:"creator"`
	Type        int     `json:"type"`
	CreatedAt   uint64  `json:"createdAt"`
	UpdatedAt   uint64  `json:"updatedAt"`
}

type (
	GetTagByIdReq {
		Id uint64 `path:"id,string"`
	}
	GetTagByIdResp {
		Tag TagItem `json:"tag"`
	}
)

type (
	GetTagByNameReq {
		Name string `form:"name"`
	}
	GetTagByNameResp {
		Tag TagItem `json:"tag"`
	}
)

type AddTagReq {
	Name        string `json:"name",validate:"max=40"`
	Image       string `json:"image,optional",validate:"120"`
	Description string `json:"description,optional",validate:"120"`
	Type        int    `json:"type,options=[1,2]"`
}

type DeleteTagReq {
	Id uint64 `path:"id,string"`
}

type UpdateTagReq {
	Id          uint64 `json:"id,string"`
	Image       string `json:"image,optional",validate:"120"`
	Description string `json:"description,optional",validate:"120"`
	QuoteCount  uint64 `json:"quoteCount,optional",validate:"gt=0"`
	Type        int    `json:"type,options=[1,2]"`
}

type (
	GetTagListReq {
		Name       string `form:"name,optional"`
		Creator    string `form:"creator,optional"`
		QuoteCount uint64 `form:"quoteCount,optional"`
		Type       int    `form:"type,options=[1,2],optional"`
		Sort       string `form:"sort,optional"`
		PageNum    int32  `form:"pageNum" validate:"required,gt=0"`
		PageSize   int32  `form:"pageSize" validate:"required,gt=0"`
	}
	GetTagListResp {
		List  []TagItem `json:"list"`
		IsEnd bool      `json:"isEnd"`
		Total uint64    `json:"total"`
	}
)

