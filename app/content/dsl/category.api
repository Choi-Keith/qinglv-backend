syntax = "v1"

info (
	title:   "分类"
	desc:    "分类"
	author:  "choikeith"
	email:   "aksoncai@gmail.com"
	version: "v1"
)

type CategoryUser {
	Id            uint64 `json:"id"`
	IsFollowing   bool   `json:"isFollowing`
	RoleId        uint64 `json:"roleId"`
	Nickname      string `json:"nickname"`
	Email         string `json:"email"`
	WeChat        string `json:"weChat"`
	Motto         string `json:"motto"`
	Avatar        string `json:"avatar"`
	Profession    string `json:"profession"`
	ProfileBg     string `json:"profileBg"`
	Age           int    `json:"age,range=[0:120]"`
	Gender        int    `json:"gender,options=[1,2],default=1"`
	Location      string `json:"location"`
	Address       string `json:"address"`
	Status        int    `json:"status"`
	Level         int    `json:"level"`
	Score         int    `json:"score"`
	MailStatus    int    `json:"mailStatus"`
	LastLoginTime uint64 `json:"lastLoginTime"`
	CreatedAt     uint64 `json:"createdAt"`
	UpdatedAt     uint64 `json:"updatedAt"`
}

type CategoryItem {
	Id          uint64 `json:"id,string"`
	Name        string `json:"name"`
	Image       string `json:"image"`
	Description string `json:"description"`
	QuoteCount  string `json:"quoteCount"`
	Creator     CategoryUser   `json:"creator"`
	CreatedAt   uint64 `json:"createdAt"`
	UpdatedAt   uint64 `json:"updatedAt"`
}

type AddCategoryReq {
	Name        string `json:"name",validate:"required,max=50"`
	Image       string `json:"image,optional",validate:"max=200"`
	Description string `json:"description,optional",validate:"max=200"`
}

type DeleteCategoryReq {
	Id uint64 `path:"id,string"`
}

type UpdateCategoryReq {
	Id          uint64 `json:"id,string"`
	Name        string `json:"name",validate:"required,max=50"`
	Image       string `json:"image,optional",validate:"max=200"`
	Description string `json:"description,optional",validate:"max=200"`
}

type (
	GetCategoryByIdReq {
		Id uint64 `path:"id,string"`
	}
	GetCategoryByIdResp {
		Category CategoryItem `json:"category"`
	}
)

type (
	GetCategoryListReq {
		Name       string `form:"name,optional"`
		Creator    string `form:"creator,optional"`
		QuoteCount uint64 `form:"quoteCount,optional"`
		PageNum    int32  `form:"pageNum" validate:"required,gt=0"`
		PageSize   int32  `form:"pageSize" validate:"required,gt=0"`
	}
	GetCategoryListResp {
		List  []CategoryItem `json:"list"`
		IsEnd bool           `json:"isEnd"`
		Total uint64         `json:"total"`
	}
)

